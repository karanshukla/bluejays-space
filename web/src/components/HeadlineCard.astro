---
import type { Headline } from '../lib/db';
import { permalinkPath } from '../lib/slug';
import { getSiteUrl } from '../lib/site';
import { smallVariantKey } from '../lib/photoImport';

const KICKER_LABELS: Record<string, string> = {
  'game-recap': 'Game Recap',
  'trade-rumor': 'Trade Rumor',
  'stat-line': 'Stat Line',
  injury: 'Injury Report',
  'roster-move': 'Roster Move',
  fabrication: 'Special Report',
  'off-field': 'Off-Field',
  other: 'Sports Desk',
};

const URGENT_CATEGORIES = new Set(['trade-rumor', 'injury', 'roster-move']);

function formatDispatchDate(iso: string | null, id: number): string {
  if (!iso) return `WIRE № ${id}`;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return `WIRE № ${id}`;
  return new Intl.DateTimeFormat('en-CA', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'America/Toronto',
  })
    .format(date)
    .toUpperCase();
}

interface Props {
  headline: Headline;
  dimmed?: boolean;
  focused?: boolean;
  eager?: boolean;
  headingLevel?: 'h1' | 'h2';
  linkBody?: boolean;
}

const {
  headline: h,
  dimmed = false,
  focused = false,
  eager = false,
  headingLevel = 'h2',
  linkBody = true,
} = Astro.props;

const HeadingTag = headingLevel;
const url = permalinkPath(h.id, h.headline);
const siteHost = getSiteUrl().hostname;
const hasSmallVariant = h.photo_ref?.endsWith('.webp') ?? false;
const kicker = (h.category && KICKER_LABELS[h.category]) || 'Sports Desk';
const isUrgent = Boolean(h.category && URGENT_CATEGORIES.has(h.category));
const dateline = formatDispatchDate(h.published_at, h.id);

const CARD_TOP =
  'flex items-center justify-between gap-2 border-b border-paper-edge/80 px-5 py-2.5 font-mono text-[0.65rem] tracking-[0.13em] uppercase';
const CARD_HEADLINE =
  'card-headline font-display text-[1.35rem] leading-[1.2] font-semibold tracking-[-0.015em] text-ink transition-colors';
const CARD_FOOTER =
  'mt-auto flex items-center justify-between gap-2 border-t border-paper-edge/80 bg-paper-tint/45 px-4 py-2';
const HOST_LABEL =
  'font-mono text-[0.6rem] font-bold tracking-[0.16em] text-ink-muted/75 uppercase';
---

<li data-headline-id={h.id}>
  <article class={`clipping ${dimmed ? 'dimmed' : ''} ${focused ? 'focused' : ''}`}>
    <div class={CARD_TOP}>
      <span class={`font-bold ${isUrgent ? 'text-red' : 'text-blue'}`}>{kicker}</span>
      <span class="text-ink-muted">{dateline}</span>
    </div>

    {h.photo_ref && (
      <div class="px-5 pt-4">
        <div class="photo-mount">
          <img
            src={`/api/images/${h.photo_ref}`}
            srcset={
              hasSmallVariant
                ? `/api/images/${smallVariantKey(h.photo_ref)} 640w, /api/images/${h.photo_ref} 1024w`
                : undefined
            }
            sizes={hasSmallVariant ? '(min-width: 640px) 460px, 100vw' : undefined}
            alt={h.headline}
            width="640"
            height="480"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : 'auto'}
          />
        </div>
      </div>
    )}

    <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
      <HeadingTag class={CARD_HEADLINE}>{h.headline}</HeadingTag>

      {h.subtitle && (
        <p class="mt-2.5 font-display text-[0.98rem] leading-snug text-ink-soft italic">
          {h.subtitle}
        </p>
      )}

      {h.source_note && (
        <p class="mt-3 font-mono text-[0.65rem] tracking-wide text-ink-muted">
          <span class="uppercase">Via</span>{' '}
          {h.source_post_url ? (
            <a
              href={h.source_post_url}
              class="card-control underline decoration-paper-edge underline-offset-2 transition-colors hover:text-blue hover:decoration-blue"
            >
              {h.source_note}
            </a>
          ) : (
            h.source_note
          )}
        </p>
      )}
    </div>

    <div class={CARD_FOOTER}>
      <a
        href={url}
        class={`card-open ${linkBody ? 'card-link' : ''} -ml-1.5 inline-flex items-center gap-1.5 px-2 py-1.5 font-mono text-[0.65rem] tracking-wider text-ink-muted uppercase transition-colors hover:text-blue`}
        title="Open this headline"
        aria-label="Open this headline"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>

      <span class="flex min-w-0 flex-col items-center text-center">
        <span class={HOST_LABEL}>{siteHost}</span>
        {h.submitter_name && (
          <span class="max-w-[14rem] truncate font-mono text-[0.6rem] text-ink-soft">
            by {h.submitter_name}
          </span>
        )}
      </span>

      <button
        type="button"
        class="copy-link card-control -mr-1.5 inline-flex items-center gap-1 px-2 py-1.5 font-mono text-[0.65rem] tracking-wider text-ink-muted uppercase transition-colors hover:text-blue"
        data-url={url}
        title="Copy link"
        aria-label="Copy link to this headline"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <span class="copy-label sr-only">Copy link</span>
      </button>
    </div>
  </article>
</li>
