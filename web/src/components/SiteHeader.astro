---
// The submit CTA is hidden on /submit itself (redundant next to the form),
// shown everywhere else.
//
// SEO heading hierarchy: the site name is the <h1> on the homepage, while on a
// permalink page the focused headline is the page's sole <h1> and the site name
// drops to a visually identical <p> via `siteNameLevel="p"`.
import { getHandlesUrl } from '../lib/site';

interface Props {
  siteNameLevel?: 'h1' | 'p';
}
const { siteNameLevel = 'h1' } = Astro.props;
const showSubmit = Astro.url.pathname !== '/submit';
const SiteNameTag = siteNameLevel;

const handlesUrl = getHandlesUrl().href;

const torontoDate = new Intl.DateTimeFormat('en-CA', {
  weekday: 'long',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Toronto',
})
  .format(new Date())
  .toUpperCase();

const EAR_BASE =
  'inline-flex items-center justify-center gap-1.5 border px-3 py-1.5 font-mono text-[0.7rem] font-bold tracking-[0.12em] uppercase transition-colors';
const WORDMARK_CLASS =
  'font-display text-5xl leading-none font-semibold tracking-[-0.035em] text-ink sm:text-6xl lg:text-[4.25rem]';
const DATELINE_CLASS =
  'flex flex-wrap items-center justify-between gap-x-4 gap-y-1 font-mono text-[0.68rem] tracking-[0.14em] text-ink-soft uppercase';
---

<header class="text-center">
  <!-- Masthead row: flanking newspaper "ears" on desktop, stacked cleanly on mobile -->
  <div class="grid grid-cols-1 items-center gap-4 pb-5 lg:grid-cols-[1fr_auto_1fr] lg:gap-6">
    <div class="order-2 flex items-center justify-center gap-2.5 lg:order-1 lg:justify-start">
      <a
        href={handlesUrl}
        rel="noopener"
        class={`${EAR_BASE} border-ink/25 bg-card text-ink hover:border-blue hover:bg-blue hover:text-white`}
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M9 7h8v8"></path>
        </svg>
        Bluesky Handles
      </a>
      {showSubmit && (
        <a
          href="/submit"
          class={`${EAR_BASE} border-blue bg-blue text-white hover:border-blue-deep hover:bg-blue-deep lg:hidden`}
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          Submit a Tip
        </a>
      )}
    </div>

    <div class="order-1 lg:order-2">
      <p class="font-mono text-[0.65rem] font-bold tracking-[0.26em] text-blue uppercase">
        Toronto Baseball Dispatch
      </p>
      <a href="/" class="mt-1 inline-block transition-opacity hover:opacity-85">
        <SiteNameTag class={WORDMARK_CLASS}>bluejays.space</SiteNameTag>
      </a>
    </div>

    <div class="order-3 hidden items-center justify-end lg:flex">
      {showSubmit && (
        <a
          href="/submit"
          class={`${EAR_BASE} border-blue bg-blue text-white hover:border-blue-deep hover:bg-blue-deep`}
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          Submit a Tip
        </a>
      )}
    </div>
  </div>

  <!-- Broadsheet double-rule dateline bar -->
  <div class="border-t-[3px] border-b border-rule py-2">
    <div class={DATELINE_CLASS}>
      <span class="font-bold text-ink">Toronto Edition</span>
      <span class="hidden sm:inline">{torontoDate}</span>
      <span class="flex items-center gap-2">
        <span>Sports Desk</span>
        <span class="text-paper-edge" aria-hidden="true">
          &middot;
        </span>
        <a href="/feed.xml" class="font-bold text-blue transition-colors hover:text-ink">
          RSS
        </a>
      </span>
    </div>
  </div>
  <div class="mt-[3px] border-t border-rule"></div>
</header>
