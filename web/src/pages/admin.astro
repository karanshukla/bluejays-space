---
import Base from '../layouts/Base.astro';
import DraftCard from '../components/DraftCard.svelte';
import PhotoInput from '../components/PhotoInput.svelte';
import { getDraftHeadlines, getPublishedHeadlinesPaged, PAGE_SIZE } from '../lib/db';
import { parsePage } from '../lib/pagination';

export const prerender = false;

// Publish is a single click with no confirm, so a page that framed /admin
// could trick a signed-in operator into publishing a draft.
Astro.response.headers.set('X-Frame-Options', 'DENY');

type Tab = 'drafts' | 'published' | 'new';
const VALID_TABS: Tab[] = ['drafts', 'published', 'new'];
const tabParam = Astro.url.searchParams.get('tab') as Tab | null;
const tab: Tab = VALID_TABS.includes(tabParam!) ? tabParam! : 'drafts';

const page = parsePage(Astro.url.searchParams.get('page'), PAGE_SIZE);
if (page === null) {
  return new Response('Bad Request', { status: 400 });
}

const drafts = await getDraftHeadlines();
const published =
  tab === 'published' ? await getPublishedHeadlinesPaged({ page, pageSize: PAGE_SIZE }) : null;

const draftsHref = '/admin?tab=drafts';
const publishedHref = '/admin?tab=published';
const newHref = '/admin?tab=new';

const publishedPage = published?.page ?? 1;
const publishedTotalPages = published?.totalPages ?? 1;
const newerHref = `/admin?tab=published&page=${Math.max(1, publishedPage - 1)}`;
const olderHref = `/admin?tab=published&page=${Math.min(publishedTotalPages, publishedPage + 1)}`;

const LABEL_CLASS = 'block font-mono text-[0.7rem] font-bold tracking-[0.12em] text-ink uppercase';
const INPUT_CLASS =
  'mt-1.5 w-full border border-paper-edge bg-paper/70 px-3 py-2 text-ink transition-colors focus:border-blue focus:bg-card focus:ring-2 focus:ring-blue/20 focus:outline-none';
const NEW_SHEET =
  'border border-ink/25 border-t-[3px] border-t-blue bg-card p-6 shadow-[4px_4px_0_rgba(13,27,46,0.1)] sm:p-8';
---

<Base title="Admin · bluejays.space">
  <main class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
    <header class="mb-6">
      <a
        href="/"
        class="font-mono text-xs font-semibold tracking-[0.12em] text-blue uppercase transition-colors hover:text-ink"
      >
        &larr; bluejays.space
      </a>

      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Admin</h1>
        <p class="font-mono text-xs text-ink-soft">
          <strong class="text-ink">{drafts.length}</strong> draft{drafts.length === 1 ? '' : 's'}
          awaiting review &middot; only published rows appear live
        </p>
      </div>

      <div class="broadsheet-double-rule mt-4"></div>
    </header>

    <nav class="mb-8 flex gap-1 border-b border-ink/25" aria-label="Admin sections">
      <a href={draftsHref} aria-current={tab === 'drafts' ? 'page' : undefined} class="admin-tab">
        Drafts
        <span class="admin-tab-badge">{drafts.length}</span>
      </a>
      <a
        href={publishedHref}
        aria-current={tab === 'published' ? 'page' : undefined}
        class="admin-tab"
      >
        Published
      </a>
      <a href={newHref} aria-current={tab === 'new' ? 'page' : undefined} class="admin-tab">
        New
      </a>
    </nav>

    {tab === 'drafts' && (
      <section class="space-y-6">
        {drafts.length === 0 ? (
          <div class="border border-dashed border-paper-edge bg-card p-10 text-center">
            <p class="font-mono text-xs tracking-wider text-ink-soft uppercase">
              No drafts right now. Open{' '}
              <a href={newHref} class="font-semibold text-blue underline hover:text-ink">
                New
              </a>{' '}
              to write one.
            </p>
          </div>
        ) : (
          <ul class="space-y-6">
            {drafts.map((draft) => (
              <DraftCard client:load draft={draft} />
            ))}
          </ul>
        )}
      </section>
    )}

    {tab === 'published' && published && (
      <section class="space-y-6">
        <p class="font-mono text-xs text-ink-soft">
          Unpublish to pull one back off the public feed for another edit.
          {published.total > 0 && (
            <>
              {' '}
              Showing {(published.page - 1) * published.pageSize + 1}–
              {Math.min(published.total, published.page * published.pageSize)} of {published.total}.
            </>
          )}
        </p>

        {published.rows.length === 0 ? (
          <div class="border border-dashed border-paper-edge bg-card p-10 text-center">
            <p class="font-mono text-xs tracking-wider text-ink-soft uppercase">
              Nothing published yet.
            </p>
          </div>
        ) : (
          <ul class="space-y-6">
            {published.rows.map((draft) => (
              <DraftCard client:load draft={draft} />
            ))}
          </ul>
        )}

        {publishedTotalPages > 1 && (
          <nav
            class="flex items-center justify-between border-t border-paper-edge pt-4"
            aria-label="Published pages"
          >
            <a
              href={newerHref}
              aria-disabled={publishedPage <= 1 ? 'true' : undefined}
              class={`admin-page-link ${publishedPage <= 1 ? 'pointer-events-none opacity-40' : ''}`}
            >
              &larr; Newer
            </a>
            <span class="font-mono text-xs tracking-wider text-ink-soft uppercase">
              Page {publishedPage} of {publishedTotalPages}
            </span>
            <a
              href={olderHref}
              aria-disabled={publishedPage >= publishedTotalPages ? 'true' : undefined}
              class={`admin-page-link ${publishedPage >= publishedTotalPages ? 'pointer-events-none opacity-40' : ''}`}
            >
              Older &rarr;
            </a>
          </nav>
        )}
      </section>
    )}

    {tab === 'new' && (
      <section>
        <div class={NEW_SHEET}>
          <h2 class="font-display text-2xl font-bold text-ink">New headline</h2>
          <p class="mb-5 text-sm text-ink-soft">Goes to draft first.</p>
          <form class="space-y-4" method="POST" action="/admin/api/headlines/create">
            <label class={LABEL_CLASS}>
              Headline
              <textarea
                name="headline"
                required
                rows="2"
                class={`${INPUT_CLASS} font-display text-lg font-normal tracking-normal normal-case`}
              ></textarea>
            </label>
            <label class={LABEL_CLASS}>
              Subtitle
              <input
                name="subtitle"
                class={`${INPUT_CLASS} font-display text-base font-normal tracking-normal normal-case italic`}
              />
            </label>
            <div>
              <span class={LABEL_CLASS}>Photo</span>
              <div class="mt-1.5">
                <PhotoInput client:load name="photo_ref" />
              </div>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label class={LABEL_CLASS}>
                Source post URL{' '}
                <span class="font-normal text-ink-muted normal-case">(optional)</span>
                <input
                  name="source_post_url"
                  class={`${INPUT_CLASS} font-sans text-sm font-normal tracking-normal normal-case`}
                />
              </label>
              <label class={LABEL_CLASS}>
                Source note{' '}
                <span class="font-normal text-ink-muted normal-case">(classifier context)</span>
                <input
                  name="source_note"
                  class={`${INPUT_CLASS} font-sans text-sm font-normal tracking-normal normal-case`}
                />
              </label>
            </div>
            <div class="pt-2">
              <button
                type="submit"
                class="cursor-pointer border border-blue bg-blue px-5 py-2.5 font-mono text-xs font-bold tracking-[0.14em] text-white uppercase transition-colors hover:border-blue-deep hover:bg-blue-deep"
              >
                Add draft
              </button>
            </div>
          </form>
        </div>
      </section>
    )}
  </main>
</Base>

<style is:global>
  .admin-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.1rem;
    margin-bottom: -1px;
    border: 1px solid transparent;
    border-top-width: 3px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft, #435368);
    text-decoration: none;
    transition:
      color 0.12s ease-out,
      background-color 0.12s ease-out;
  }
  .admin-tab:hover {
    color: var(--color-ink, #0d1b2e);
    background-color: color-mix(in srgb, var(--color-blue, #134a8e) 6%, transparent);
  }
  .admin-tab[aria-current='page'] {
    color: var(--color-ink, #0d1b2e);
    background-color: var(--color-card, #fdfcf9);
    border-color: color-mix(in srgb, var(--color-ink, #0d1b2e) 25%, transparent);
    border-top-color: var(--color-blue, #134a8e);
    border-bottom-color: var(--color-card, #fdfcf9);
  }
  .admin-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    background-color: var(--color-paper-tint, #ebe6dc);
    color: var(--color-ink, #0d1b2e);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .admin-page-link {
    border: 1px solid var(--color-paper-edge, #d1c9ba);
    background-color: var(--color-card, #fdfcf9);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue, #134a8e);
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    transition:
      background-color 0.12s ease-out,
      color 0.12s ease-out,
      border-color 0.12s ease-out;
  }
  .admin-page-link:hover {
    background-color: var(--color-blue, #134a8e);
    border-color: var(--color-blue, #134a8e);
    color: #ffffff;
  }
</style>
