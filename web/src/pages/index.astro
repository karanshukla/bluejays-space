---
import Base from '../layouts/Base.astro';
import HeadlineCard from '../components/HeadlineCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SubmitCallout from '../components/SubmitCallout.astro';
import { getPublishedHeadlinesPaged } from '../lib/db';

export const prerender = false;

// First page renders server-side for SEO and no-JS visitors; subsequent pages
// are fetched as an HTML fragment from /feed-fragment and injected by the
// IntersectionObserver below. Pagination is plain page numbers (OFFSET), shared
// with the admin tab — see getPublishedHeadlinesPaged in lib/db.ts.
const { rows, totalPages } = await getPublishedHeadlinesPaged({ page: 1 });
// 0 = last page reached; the observer treats that as "done".
const nextPage = totalPages > 1 ? 2 : 0;
---

<Base title="bluejays.space">
  <main class="mx-auto max-w-[1600px] px-6 py-12 sm:px-10">
    <SiteHeader />

    <SubmitCallout class="mt-10" />

    {
      rows.length === 0 && (
        <p class="mt-16 text-center font-mono text-sm text-ink-soft">
          No headlines published yet. Check back soon.
        </p>
      )
    }

    <ul class="scrapbook-grid mt-14" id="feed" data-next-page={nextPage}>
      {rows.map((h, i) => <HeadlineCard headline={h} eager={i < 4} />)}
    </ul>

    <!-- Sentinel the observer watches. data-next-page on #feed drives the next
         fetch; when it reaches 0 the observer stops (last page). -->
    <div id="feed-sentinel" class="h-px w-full" aria-hidden="true"></div>
    <noscript>
      <p class="mt-8 text-center font-mono text-xs text-ink-soft">
        Showing the latest headlines. Enable JavaScript for infinite scroll.
      </p>
    </noscript>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const path = btn.dataset.url;
        if (!path) return;
        try {
          await navigator.clipboard.writeText(`${location.origin}${path}`);
          const svg = btn.querySelector('svg');
          if (svg) {
            svg.style.color = 'var(--color-blue)';
            setTimeout(() => (svg.style.color = ''), 1500);
          }
        } catch {
          window.open(path, '_blank');
        }
      });
    });

    // Remember the feed's scroll position so tapping outside the focused card
    // on a permalink page (see h/[id].astro) can restore it here, instead of
    // that fresh navigation always landing at the top of the page.
    window.addEventListener(
      'scroll',
      () => sessionStorage.setItem('feedScrollY', String(window.scrollY)),
      { passive: true }
    );

    const params = new URLSearchParams(location.search);
    if (params.has('restoreScroll')) {
      const y = Number(sessionStorage.getItem('feedScrollY'));
      if (Number.isFinite(y) && y > 0) window.scrollTo(0, y);
      params.delete('restoreScroll');
      const rest = params.toString();
      history.replaceState(null, '', location.pathname + (rest ? `?${rest}` : ''));
    }

    // --- Infinite scroll (issue #123) -------------------------------------
    // Watch a sentinel at the bottom of the feed. When it intersects, fetch the
    // next page as an HTML fragment from /feed-fragment?page=N (same HeadlineCard
    // as the first page, so there's one card template) and insert the whole
    // returned <ul> as a sibling block before the sentinel.
    //
    // Why sibling blocks instead of splicing <li>s into #feed: the scrapbook is
    // CSS multi-column (column-count), and multi-column rebalances its columns
    // every time a child is appended — so splicing later pages' cards into #feed
    // reflowed every earlier card between columns and made the feed visibly
    // "shuffle" as you scrolled (issue #141), worst in landscape. Giving each
    // page its own self-contained column box means earlier pages never
    // recompute: cards stay exactly where they first painted. The tradeoff is a
    // slight ragged seam between every page (≈12 cards), which reads as natural
    // scrapbook spacing. Stops when the fragment reports page 0 (last page).
    // Re-binds copy-link to injected cards.
    const feed = document.getElementById('feed');
    const sentinel = document.getElementById('feed-sentinel');
    if (feed && sentinel && 'IntersectionObserver' in window) {
      let loading = false;
      let done = false;

      const bindCopyLink = (root: ParentNode) => {
        root.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', async () => {
            const path = btn.dataset.url;
            if (!path) return;
            try {
              await navigator.clipboard.writeText(`${location.origin}${path}`);
              const svg = btn.querySelector('svg');
              if (svg) {
                svg.style.color = 'var(--color-blue)';
                setTimeout(() => (svg.style.color = ''), 1500);
              }
            } catch {
              window.open(path, '_blank');
            }
          });
        });
      };

      const loadMore = async () => {
        if (loading || done) return;
        const nextPage = Number(feed.dataset.nextPage);
        if (!nextPage) {
          done = true;
          return;
        }
        loading = true;
        try {
          const res = await fetch(`/feed-fragment?page=${nextPage}`);
          if (!res.ok) return;
          const html = await res.text();
          const tmp = document.createElement('template');
          tmp.innerHTML = html;
          const frag = tmp.content;
          const list = frag.querySelector<HTMLUListElement>('ul.feed-fragment');
          if (!list) return;
          const cards = Array.from(list.children) as HTMLLIElement[];
          if (cards.length === 0) {
            done = true;
            return;
          }
          // Insert the page as its own self-contained column block ahead of the
          // sentinel. Earlier blocks never reflow → no shuffle (issue #141).
          sentinel.before(list);
          // Adopt the fragment's next-page number; 0 = last page, stop.
          feed.dataset.nextPage = list.dataset.nextPage ?? '0';
          if (!Number(feed.dataset.nextPage)) done = true;
          bindCopyLink(list);
        } catch {
          // Network errors shouldn't kill the observer — just skip this round.
        } finally {
          loading = false;
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) loadMore();
        },
        { rootMargin: '600px 0px' }
      );
      observer.observe(sentinel);
    }
  </script>
</Base>
