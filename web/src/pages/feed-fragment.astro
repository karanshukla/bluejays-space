---
// Infinite-scroll fragment (issue #123). The browser's IntersectionObserver
// fetches this page as the user nears the bottom of the feed; it returns the
// next batch of cards rendered through the *same* HeadlineCard component the
// first page uses, so there is exactly one card template in the codebase — no
// hand-maintained JS string that has to stay in sync with HeadlineCard.astro.
//
// Pagination is by ?page=N (OFFSET), shared with the admin Published tab — see
// getPublishedHeadlinesPaged for why page numbers beat the old keyset cursor.
// The fragment echoes the next page number (or 0 when this is the last page) as
// data-next-page so the observer knows whether to fetch again.
import HeadlineCard from '../components/HeadlineCard.astro';
import { getPublishedHeadlinesPaged } from '../lib/db';
import { nextPageAfter } from '../lib/pagination';

export const prerender = false;

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const { rows, page: current, totalPages } = await getPublishedHeadlinesPaged({ page });

const nextPage = nextPageAfter(current, totalPages);
---

<ul class="scrapbook-grid feed-fragment" data-next-page={nextPage}>
  {rows.map((h) => <HeadlineCard headline={h} />)}
</ul>
