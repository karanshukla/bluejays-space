---
import Base, { DEFAULT_DESCRIPTION } from '../../layouts/Base.astro';
import HeadlineCard from '../../components/HeadlineCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getHeadlineById, getPublishedHeadlinesPaged } from '../../lib/db';
import { permalinkPath } from '../../lib/slug';
import { permalinkDescription } from '../../lib/permalinkMeta';

export const prerender = false;

// The param is `{id}-{slug}` (e.g. "7-vladimir-guerrero-jr-hits-ball-into-orbit").
// A bare id ("7") still works — redirect to the canonical slugged URL for SEO.
const match = Astro.params.id?.match(/^(\d+)/);
const id = match ? Number(match[1]) : NaN;
if (!Number.isInteger(id) || id <= 0) {
  return new Response('Not Found', { status: 404 });
}

const headline = await getHeadlineById(id);
if (!headline) {
  return new Response('Not Found', { status: 404 });
}

const canonical = permalinkPath(id, headline.headline);
if (Astro.url.pathname !== canonical) {
  return Astro.redirect(canonical, 301);
}

// Dimmed backdrop: previously loaded *all* published rows (issue #123). Now
// capped to the first page — enough to fill the viewport as a backdrop, without
// pulling the full history on every permalink view. The focused card is always
// included: if it's older than the first page (rare, but possible for an old
// permalink), prepend it so it still renders focused rather than vanishing.
const { rows: backdrop } = await getPublishedHeadlinesPaged({ page: 1 });
const headlines = backdrop.some((h) => h.id === id)
  ? backdrop
  : [headline, ...backdrop.filter((h) => h.id !== id)];

// Always point at the per-headline dynamic image rather than gating on a
// User-Agent allowlist — that list can never cover every unfurl bot (Pinterest,
// KakaoTalk, Viber, Mastodon instances, iMessage's non-identifying fetcher,
// whatever ships next), and under-matching silently falls back to the generic
// site image instead of the real headline. The route itself (api/og/[id].png.ts)
// is content-hash-cached in MinIO and immutable, so serving the real image to
// every visitor costs nothing extra: a human's browser never fetches an
// unrendered <meta> image, and any bot that does hit it gets a cache hit after
// the first render for that headline's current content.
const ogImage = `/api/og/${id}.png`;

const description = permalinkDescription(headline, DEFAULT_DESCRIPTION);
---

<Base
  title={headline.headline}
  description={description}
  ogType="article"
  canonicalPath={canonical}
  ogImage={ogImage}
  ogImageAlt={headline.headline}
  articlePublishedTime={headline.published_at ?? undefined}
>
  <main class="permalink-overlay mx-auto max-w-[1600px] px-6 py-12 sm:px-10" data-focus-id={id}>
    <SiteHeader siteNameLevel="p" />

    <ul class="scrapbook-grid mt-14">
      {
        headlines.map((h, i) => (
          <HeadlineCard
            headline={h}
            dimmed={h.id !== id}
            eager={h.id === id || i < 2}
            headingLevel={h.id === id ? 'h1' : 'h2'}
            linkBody={false}
          />
        ))
      }
    </ul>

    {
      /* Inline, and placed immediately after the list rather than in the module
        script below, because it has to land before the browser's first paint:
        a deferred script scrolls a page the visitor has already seen, which is
        the jump this is here to remove. Runs again at DOMContentLoaded in case
        the mid-parse document was still too short to scroll that far. */
    }
    <script is:inline define:vars={{ focusId: id }}>
      (() => {
        const card = document.querySelector(`li[data-headline-id="${focusId}"]`);
        if (!card) return;
        card.style.viewTransitionName = 'card-focus';

        let anchorTop = null;
        try {
          const saved = JSON.parse(sessionStorage.getItem('cardAnchor') || 'null');
          if (saved && String(saved.id) === String(focusId) && Number.isFinite(saved.top)) {
            anchorTop = saved.top;
          }
        } catch {
          // Unparseable/blocked storage just means no anchor to honour.
        }

        // Opened from the feed: put the card back at the exact viewport offset
        // it was clicked at, so it doesn't visibly move between the two pages.
        // Arrived cold from a shared link: centre it, since there's no position
        // to preserve.
        const place = () => {
          if (anchorTop === null) card.scrollIntoView({ block: 'center' });
          else window.scrollBy(0, card.getBoundingClientRect().top - anchorTop);
        };
        place();
        document.addEventListener('DOMContentLoaded', place, { once: true });
      })();
    </script>
  </main>

  <script>
    import { bindCopyLinks, rememberOpenedCard } from '../../scripts/cardInteractions';

    bindCopyLinks();
    rememberOpenedCard();

    const focusId = document.querySelector<HTMLElement>('.permalink-overlay')?.dataset.focusId;

    // Going *back* rather than pushing a fresh '/' lets the browser restore the
    // feed from bfcache — its scroll position and any infinite-scrolled pages
    // intact, instantly, exactly where the visitor left off. Only correct when
    // the feed is genuinely the previous entry; someone who landed here from a
    // shared link gets a normal navigation with the saved-scroll fallback.
    function returnToFeed() {
      const referrer = document.referrer ? new URL(document.referrer) : null;
      if (referrer?.origin === location.origin && referrer.pathname === '/') history.back();
      else location.href = '/?restoreScroll=1';
    }

    // Click anywhere that isn't the focused card → back to the feed. Checking
    // against `.clipping` in general was a bug: every dimmed background card
    // matches that selector too, so on a feed with more than a couple of
    // headlines the greyed-out backdrop (the part users actually click,
    // expecting a lightbox-style dismiss) covered almost the entire page and
    // silently did nothing. Only the one focused card should count as "safe";
    // every other card is backdrop. Links/buttons always keep their own
    // behavior (open the other headline, copy its link) regardless of which
    // card they're in.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button')) return;

      const focusedCard = focusId
        ? document.querySelector(`li[data-headline-id="${focusId}"] .clipping`)
        : null;
      if (focusedCard?.contains(target)) return;

      returnToFeed();
    });
  </script>
</Base>
