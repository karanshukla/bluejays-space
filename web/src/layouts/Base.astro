---
import '../styles/global.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import { getHandlesUrl, getSiteUrl } from '../lib/site';

export const DEFAULT_DESCRIPTION = 'The best Blue Jays misinformation on the web';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  // ISO timestamp
  articlePublishedTime?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  canonicalPath,
  articlePublishedTime,
} = Astro.props;

const site = getSiteUrl();
const handlesUrl = getHandlesUrl().href;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site);
const imageUrl = new URL(ogImage ?? '/og-default.png', site);
const desc = description ?? DEFAULT_DESCRIPTION;
const imageAlt = ogImageAlt ?? title;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'bluejays.space',
  url: site.href,
  description: DEFAULT_DESCRIPTION,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-256.png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{title}</title>

    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={desc} />

    <meta property="og:site_name" content="bluejays.space" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articlePublishedTime && (
      <meta
        property="article:published_time"
        content={new Date(articlePublishedTime).toISOString()}
      />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="alternate" type="application/rss+xml" title="bluejays.space" href="/feed.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)}></script>
  </head>
  <body class="flex min-h-screen flex-col text-ink antialiased">
    <div class="flex-1">
      <slot />
    </div>
    <footer class="mx-auto mt-20 w-full max-w-[1440px] px-5 pb-12 sm:px-8 lg:px-10">
      <div class="broadsheet-double-rule mb-6"></div>
      <div class="flex flex-col items-center justify-between gap-4 text-center font-mono text-xs text-ink-soft sm:flex-row sm:text-left">
        <p class="leading-relaxed">
          <strong class="font-bold text-ink">bluejays.space</strong> is a parody/satire site. Not
          affiliated with MLB or the Toronto Blue Jays.
        </p>
        <nav
          class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-[0.7rem] tracking-wider uppercase"
          aria-label="Footer"
        >
          <a
            href="/submit"
            class="text-ink underline decoration-paper-edge underline-offset-4 transition-colors hover:text-blue hover:decoration-blue"
          >
            Submit a headline
          </a>
          <span class="text-paper-edge" aria-hidden="true">/</span>
          <a
            href={handlesUrl}
            rel="noopener"
            class="text-ink underline decoration-paper-edge underline-offset-4 transition-colors hover:text-blue hover:decoration-blue"
          >
            Bluesky Handles
          </a>
          <span class="text-paper-edge" aria-hidden="true">/</span>
          <a
            href="/feed.xml"
            class="text-ink underline decoration-paper-edge underline-offset-4 transition-colors hover:text-blue hover:decoration-blue"
          >
            RSS
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
